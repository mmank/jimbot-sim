# Extracted from your own Balatro install at runtime; never redistributed.
vendor/
__pycache__/
*.pyc
.pytest_cache/

# modded game build output (57MB, rebuildable from your own install)
vendor/modded_game/

# recorded human games, kept as regression fixtures
!recordings/

.venv/

# built by hand with python native/build.py, not checked in
native/*.dll
native/*.so
native/*.dylib
